showOpen = function()

	clearContent()

	local t = Themes[currentTheme]

	local back = makeButton(
		content,
		"←",
		UDim2.fromOffset(2,0),
		UDim2.fromOffset(40,35),
		t.button
	)

	back.MouseButton1Click:Connect(showHome)

	local randomButton = makeButton(
		content,
		"🔀 ACAK",
		UDim2.new(1,-145,0,0),
		UDim2.fromOffset(65,35),
		Color3.fromRGB(125,70,180)
	)

	local all = makeButton(
		content,
		"BUKA SEMUA",
		UDim2.new(1,-75,0,0),
		UDim2.fromOffset(73,35),
		Color3.fromRGB(180,110,40)
	)

	local area = Instance.new("ScrollingFrame")
	area.Size = UDim2.new(1,-5,1,-45)
	area.Position = UDim2.fromOffset(2,42)
	area.BackgroundTransparency = 1
	area.BorderSizePixel = 0
	area.ScrollBarThickness = 4
	area.Parent = content

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(68,62)
	grid.CellPadding = UDim2.fromOffset(7,7)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = area

	local buttons = {}

	--------------------------------------------------
	-- REFRESH KOTAK
	--------------------------------------------------

	local function refreshButton(position)

		local button = buttons[position]

		-- ANGKA LUAR SELALU TETAP
		button.Text = tostring(position)

		if opened[position] then

			local contentIndex = shuffledContent[position]

			if names[contentIndex] ~= "" then
				button.Text = names[contentIndex]
			else
				button.Text = tostring(contentIndex)
			end

			button.TextSize = 11
			button.TextWrapped = true
			button.BackgroundColor3 = Color3.fromRGB(55,155,85)

		else

			button.Text = tostring(position)
			button.TextSize = 25
			button.TextWrapped = false
			button.BackgroundColor3 = t.box

		end

	end

	--------------------------------------------------
	-- KOTAK 1-10
	--------------------------------------------------

	for position = 1,boxCount do

		local b = Instance.new("TextButton")

		b.Font = Enum.Font.GothamBold
		b.TextColor3 = Color3.new(1,1,1)
		b.Parent = area

		Instance.new("UICorner",b).CornerRadius = UDim.new(0,9)

		buttons[position] = b

		refreshButton(position)

		b.MouseButton1Click:Connect(function()

			opened[position] = true
			refreshButton(position)

		end)

	end

	--------------------------------------------------
	-- ACAK ISI SAJA
	--------------------------------------------------

	randomButton.MouseButton1Click:Connect(function()

		-- Tutup semua
		for i = 1,10 do
			opened[i] = false
		end

		-- Buat daftar isi
		for i = 1,boxCount do
			shuffledContent[i] = i
		end

		-- Acak isi
		for i = boxCount,2,-1 do

			local j = math.random(1,i)

			shuffledContent[i],
			shuffledContent[j] =
				shuffledContent[j],
				shuffledContent[i]

		end

		-- Refresh
		for i = 1,boxCount do
			refreshButton(i)
		end

	end)

	--------------------------------------------------
	-- BUKA SEMUA
	--------------------------------------------------

	all.MouseButton1Click:Connect(function()

		for i = 1,boxCount do
			opened[i] = true
			refreshButton(i)
		end

	end)

	task.defer(function()

		area.CanvasSize = UDim2.fromOffset(
			0,
			grid.AbsoluteContentSize.Y + 10
		)

	end)

end

